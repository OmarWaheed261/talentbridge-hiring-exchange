{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://sifheywkffecbyaltnlc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "talentbridge-mcp",
      "version": "0.1.0",
      "title": "TalentBridge AI"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in TalentBridge user's profile (name, email, consultancy, roles). Useful to confirm the MCP connection is authenticated.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_jobs",
        "title": "List jobs",
        "description": "List jobs visible to the signed-in TalentBridge user. Results are scoped by row-level security to the caller's consultancy and role.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "on_hold",
                "filled"
              ],
              "description": "Optional job status filter."
            },
            "search": {
              "type": "string",
              "description": "Case-insensitive substring matched against job title or company."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Max rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_candidates",
        "title": "List candidates",
        "description": "List candidates the signed-in TalentBridge user can see. Filter by status, skill keyword, or linked job. Row-level security scopes results to the caller's consultancy.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "submitted",
                "screening",
                "interview",
                "offer",
                "hired",
                "rejected"
              ],
              "description": "Optional candidate status filter."
            },
            "skill": {
              "type": "string",
              "description": "Return candidates whose skills array contains this keyword (case-sensitive match)."
            },
            "linked_job_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filter to candidates linked to a specific job."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Max rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
