    {
      "parameters": {
        "jsCode": "// Map the incoming webhook payload to the candidate schema.\n// Expected upstream fields (adjust to your form / parser):\n//   name, email, phone, experience, skills (string|array), resume_url,\n//   notes, linked_job_id, consultancy_id\nconst src = $input.first().json.body ?? $input.first().json;\nconst toArr = (v) => Array.isArray(v)\n  ? v\n  : typeof v === 'string'\n    ? v.split(',').map((s) => s.trim()).filter(Boolean)\n    : [];\nreturn [{\n  json: {\n    candidate_name: src.name ?? src.candidate_name,\n    email: src.email ?? null,\n    phone: src.phone ?? null,\n    experience: src.experience ?? null,\n    skills: toArr(src.skills),\n    resume_url: src.resume_url ?? null,\n    notes: src.notes ?? null,\n    linked_job_id: src.linked_job_id ?? null,\n    consultancy_id: src.consultancy_id ?? null,\n    status: src.status ?? 'submitted',\n  },\n}];"
      },
      "id": "map",
      "name": "Map → candidate schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$('Set Base URL').item.json.baseUrl}}/api/public/n8n/candidates",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
